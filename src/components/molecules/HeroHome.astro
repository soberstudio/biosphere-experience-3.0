---
import { Picture } from "astro:assets";
import Bouton from "../atoms/Bouton.astro";

const { src, alt = "Biosphère Experience" } = Astro.props;
---

<div id="hero" class="hero-wrapper">
  <Picture
    src={src}
    alt={alt}
    class="w-full h-full object-cover object-bottom"
    formats={["avif", "webp", "jpeg"]}
    sizes="100vw"
    widths={[1200, 5000]}
  />
{/*
  <Bouton
    href="https://odk.oury-cloud24.segi.ulg.ac.be/f/IhIsl3I09Kjmpn3EvDGEfhgoy1jJYWu?st=ZjB9Fm7N5kspo!C0wkUXRwGDO1pz2zEqWKusUunQMzkr7RswnAGZpQZZ551S5P6y"
    text="sciences citoyennes, candidatez ici !"
  />
*/}
</div>


<style>
  .hero-wrapper {
    position: relative;
    height: clamp(420px, calc(420px + (2000 - 420) * ((100vw - 320px) / (5120 - 320))), 600px);
  }
</style>
